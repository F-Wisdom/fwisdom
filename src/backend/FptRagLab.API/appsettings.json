{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=fpt_rag_lab;Username=postgres;Password=yourpassword"
  },
  "Jwt": {
    "Key": "YOUR_SUPER_SECRET_KEY_MIN_256_BITS_CHANGE_IN_PRODUCTION",
    "Issuer": "FptRagLabApi",
    "Audience": "FptRagLabClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5173"
  },
  "FileStorage": {
    "BasePath": "uploads",
    "MaxFileSizeMb": 50,
    "AllowedExtensions": [ ".pdf", ".docx" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
